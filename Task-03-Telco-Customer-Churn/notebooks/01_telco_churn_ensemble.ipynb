    "best_strategy = {}\n",
    "for model_name in [\"Random Forest\", \"XGBoost\"]:\n",
    "    subset = comparison[comparison[\"Model\"] == model_name]\n",
    "    best_strategy[model_name] = subset.loc[subset[\"Test ROC-AUC\"].idxmax(), \"Balancing\"]\n",
    "\n",
    "print(\"Best balancing strategy per model:\")\n",
    "for model_name, strategy in best_strategy.items():\n",
    "    score = comparison.loc[\n",
    "        (comparison[\"Model\"] == model_name) & (comparison[\"Balancing\"] == strategy),\n",
    "        \"Test ROC-AUC\",\n",
    "    ].iloc[0]\n",
    "    print(f\"  {model_name}: {strategy} (test ROC-AUC {score:.4f})\")\n",
    "\n",
    "\n",
    "def top_importances(model, n=10):\n",
    "    return pd.Series(model.feature_importances_, index=X_train.columns).sort_values(ascending=False).head(n)\n",
    "\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(18, 7))\n",
    "\n",
    "for ax, model_name in zip(axes, [\"Random Forest\", \"XGBoost\"]):\n",
    "    strategy = best_strategy[model_name]\n",
    "    estimator = searches[(model_name, strategy)].best_estimator_.named_steps[\"model\"]\n",
    "    top = top_importances(estimator)\n",
    "    top.plot(kind=\"barh\", ax=ax, color=\"steelblue\")\n",
    "    ax.set_title(f\"{model_name} ({strategy}) - Top 10 Feature Importances\")\n",
    "    ax.set_xlabel(\"Importance\")\n",
