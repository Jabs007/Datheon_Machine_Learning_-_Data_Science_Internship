  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Preprocessing: OneHotEncoder and Train/Test Split\n",
    "\n",
    "`OneHotEncoder` turns the 15 categorical columns into binary indicators. The\n",
    "first level of each is dropped to avoid a redundant dummy column. Tree-based\n",
    "models do not need feature scaling, so the numeric columns are left as they are.\n",
    "\n",
    "The split is **stratified** so the churn rate is preserved in both sets."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "encoder = OneHotEncoder(drop=\"first\", sparse_output=False, handle_unknown=\"ignore\")\n",
    "encoder.fit(df[CATEGORICAL_COLUMNS])\n",
    "\n",
    "ENCODED_COLUMNS = list(encoder.get_feature_names_out(CATEGORICAL_COLUMNS))\n",
    "\n",
    "X = pd.concat(\n",
    "    [\n",
    "        df[NUMERIC_COLUMNS].reset_index(drop=True),\n",
    "        pd.DataFrame(\n",
    "            encoder.transform(df[CATEGORICAL_COLUMNS]),\n",
    "            columns=ENCODED_COLUMNS,\n",
    "            index=df.index,\n",
    "        ),\n",
    "    ],\n",
    "    axis=1,\n",
    ")\n",
    "y = df[TARGET]\n",
    "\n",
    "print(f\"Features after encoding: {X.shape[1]} \"\n",
    "      f\"({len(NUMERIC_COLUMNS)} numeric + {len(ENCODED_COLUMNS)} one-hot)\")\n",
    "print(\"\\nEncoded columns:\")\n",
    "print(ENCODED_COLUMNS)\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.20, random_state=RANDOM_STATE, stratify=y\n",
    ")\n",
    "\n",
    "print(f\"\\nTraining set: {X_train.shape} | Test set: {X_test.shape}\")\n",
    "print(f\"Train churn rate: {y_train.mean():.2%} | Test churn rate: {y_test.mean():.2%}\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "print(\"Encoded feature dtypes:\")\n",
    "print(X.dtypes.value_counts().to_string())\n",
    "print(\"\\nSample of the encoded matrix:\")\n",
    "display(X.head())\n",
    "print(\"\\nAny missing values in the matrix:\", int(X.isnull().sum().sum()))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Class Imbalance\n",
    "\n",
    "Churn is a minority class. Balancing it is one of the task requirements, so the\n",
    "notebook compares three strategies rather than picking one blindly."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "train_counts = y_train.value_counts().sort_index()\n",
    "print(\"Training set class distribution:\")\n",
    "print(train_counts.to_string())\n",
    "\n",
    "majority, minority = int(train_counts.max()), int(train_counts.min())\n",
    "ratio = majority / minority\n",
    "print(f\"\\nImbalance ratio: {ratio:.2f} : 1\")\n",
    "print(f\"scale_pos_weight for XGBoost: {ratio:.4f}\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7, 5))\n",
    "train_counts.plot(kind=\"bar\", ax=ax, color=[\"steelblue\", \"coral\"])\n",
    "ax.set_title(\"Training Set Class Imbalance\")\n",
    "ax.set_xlabel(\"Churn\")\n",
    "ax.set_ylabel(\"Customers\")\n",
    "ax.set_xticklabels([\"No churn (0)\", \"Churn (1)\"], rotation=0)\n",
    "for index, value in enumerate(train_counts.values):\n",
    "    ax.text(index, value, f\"{value:,}\", ha=\"center\", va=\"bottom\")\n",
    "plt.tight_layout()\n",
    "savefig(\"class_imbalance.png\")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Balancing Strategies and Hyperparameter Tuning\n",
    "\n",
    "Three strategies are compared for each classifier:\n",
    "\n",
    "| Strategy | How it works |\n",
    "| --- | --- |\n",
    "| `none` | No balancing \u2014 the natural 2.74 : 1 imbalance is left as is. |\n",
    "| `class_weight` | `class_weight=\"balanced\"` for Random Forest, `scale_pos_weight` for XGBoost. |\n",
    "| `smote` | `SMOTE` oversamples the minority class in the training folds only. |\n",
    "\n",
    "SMOTE is placed **inside the cross-validation pipeline**, so it is fitted on each\n",
    "fold's training partition and never sees the validation partition. Applying it\n",
    "once to the whole training set before cross-validation would leak information\n",
    "and inflate the scores.\n",
    "\n",
    "Each strategy is tuned with `GridSearchCV` (5-fold stratified, scored by ROC-AUC)."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "RF_GRID = {\n",
    "    \"n_estimators\": [200, 400],\n",
    "    \"max_depth\": [None, 10],\n",
    "    \"min_samples_leaf\": [1, 2],\n",
    "}\n",
    "XGB_GRID = {\n",
    "    \"n_estimators\": [200, 400],\n",
    "    \"max_depth\": [3, 6],\n",
    "    \"learning_rate\": [0.1],\n",
    "}\n",
    "SCALE_POS_WEIGHT = float(train_counts.max() / train_counts.min())\n",
    "STRATEGIES = [\"none\", \"class_weight\", \"smote\"]\n",
    "\n",
    "\n",
    "def build_pipeline(strategy, model_name):\n",
    "    if model_name == \"Random Forest\":\n",
    "        classifier = RandomForestClassifier(random_state=RANDOM_STATE, n_jobs=-1)\n",
    "        if strategy == \"class_weight\":\n",
    "            classifier.set_params(class_weight=\"balanced\")\n",
    "        grid = {f\"model__{key}\": value for key, value in RF_GRID.items()}\n",
    "    else:\n",
    "        classifier = XGBClassifier(random_state=RANDOM_STATE, eval_metric=\"logloss\", n_jobs=-1)\n",
    "        if strategy == \"class_weight\":\n",
    "            classifier.set_params(scale_pos_weight=SCALE_POS_WEIGHT)\n",
    "        grid = {f\"model__{key}\": value for key, value in XGB_GRID.items()}\n",
    "\n",
    "    steps = []\n",
    "    if strategy == \"smote\":\n",
    "        steps.append((\"smote\", SMOTE(random_state=RANDOM_STATE)))\n",
    "    steps.append((\"model\", classifier))\n",
    "\n",
    "    return ImbPipeline(steps), grid\n",
    "\n",
    "\n",
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=RANDOM_STATE)\n",
    "searches = {}\n",
    "for model_name in [\"Random Forest\", \"XGBoost\"]:\n",
    "    for strategy in STRATEGIES:\n",
    "        pipeline, grid = build_pipeline(strategy, model_name)\n",
    "        search = GridSearchCV(\n",
    "            pipeline, grid, scoring=\"roc_auc\", cv=cv, n_jobs=-1, verbose=0\n",
    "        )\n",
    "        search.fit(X_train, y_train)\n",
    "        searches[(model_name, strategy)] = search\n",
    "        print(f\"{model_name:14s} | {strategy:13s} | best CV ROC-AUC {search.best_score_:.4f}\")\n",
    "\n",
    "print(\"\\nAll grid searches completed.\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "rows = []\n",
    "probabilities = {}\n",
    "predictions = {}\n",
    "\n",
    "for (model_name, strategy), search in searches.items():\n",
    "    best_model = search.best_estimator_\n",
    "    proba = best_model.predict_proba(X_test)[:, 1]\n",
    "    pred = (proba >= 0.5).astype(int)\n",
    "    probabilities[(model_name, strategy)] = proba\n",
    "    predictions[(model_name, strategy)] = pred\n",
    "\n",
    "    best_index = search.best_index_\n",
    "    rows.append(\n",
    "        {\n",
    "            \"Model\": model_name,\n",
    "            \"Balancing\": strategy,\n",
    "            \"CV ROC-AUC\": float(search.best_score_),\n",
    "            \"CV std\": float(search.cv_results_[\"std_test_score\"][best_index]),\n",
    "            \"Test ROC-AUC\": float(roc_auc_score(y_test, proba)),\n",
    "            \"Accuracy\": float(accuracy_score(y_test, pred)),\n",
    "            \"Precision\": float(precision_score(y_test, pred, zero_division=0)),\n",
    "            \"Recall\": float(recall_score(y_test, pred, zero_division=0)),\n",
    "            \"F1\": float(f1_score(y_test, pred, zero_division=0)),\n",
    "        }\n",
    "    )\n",
    "\n",
    "comparison = pd.DataFrame(rows)\n",
    "\n",
    "print(\"MODEL COMPARISON\")\n",
    "print(\"=\" * 100)\n",
    "display(comparison.round(4))\n",
    "\n",
    "best_test = comparison.loc[comparison[\"Test ROC-AUC\"].idxmax()]\n",
    "print(f\"\\nBest test ROC-AUC: {best_test['Model']} with {best_test['Balancing']} \"\n",
    "      f\"({best_test['Test ROC-AUC']:.4f})\")\n",
    "print(f\"Target ROC-AUC > 0.80 met: {best_test['Test ROC-AUC'] > 0.80}\")"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "pivot = comparison.pivot(index=\"Balancing\", columns=\"Model\", values=\"Test ROC-AUC\")\n",
    "pivot = pivot.loc[STRATEGIES]\n",
    "pivot.plot(kind=\"bar\", ax=ax, width=0.7, color=[\"steelblue\", \"seagreen\"])\n",
    "ax.axhline(0.80, color=\"red\", linestyle=\"--\", linewidth=1.5, label=\"target = 0.80\")\n",
    "ax.set_ylabel(\"Test ROC-AUC\")\n",
    "ax.set_title(\"Test ROC-AUC by Model and Balancing Strategy\")\n",
    "ax.set_xticklabels(ax.get_xticklabels(), rotation=0)\n",
